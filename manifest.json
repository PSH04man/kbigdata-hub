{
  "manifest_version": 3,
  "name": "K-BigData Hub",
  "version": "1.7.0",
  "description": "포털 코딩 350제(Java·C·Python·Ubuntu)·실기 SQL에서 '맞혔어요'를 누르면 내 답을 GitHub에 올립니다.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.github.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://portal.k-bigdata.kr/coding.html*", "https://portal.k-bigdata.kr/practical.html*"], "js": ["lib.js", "content.js"] }
  ],
  "web_accessible_resources": [
    { "resources": ["fonts/PretendardVariable.woff2"], "matches": ["https://portal.k-bigdata.kr/*"] }
  ],
  "options_page": "options.html",
  "action": { "default_popup": "options.html", "default_title": "K-BigData Hub 설정", "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" } }
}
